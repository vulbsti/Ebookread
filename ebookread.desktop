[Desktop Entry]
Type=Application
Name=Ebookread
Comment=Ubuntu-native GTK4 / Libadwaita Ebook Reader
Exec=ebookread %F
Icon=accessories-dictionary
Terminal=false
Categories=Office;Viewer;Literature;
MimeType=application/epub+zip;application/pdf;application/x-mobipocket-ebook;application/x-fictionbook+xml;application/vnd.comicbook+zip;
StartupWMClass=io.github.vulbsti.Ebookread
